{
        "manifest_version": 3,
        "name": "POWERDIGGER for Bandcamp",
        "version": "1.0.5",
        "permissions": [
                "storage",
                "unlimitedStorage"
        ],
        "optional_permissions": [
                "history",
                "downloads",
                "management"
        ],
        "content_scripts": [{
                "matches": ["*://*.bandcamp.com/*"],
                "js": [
                        "content/shared.js",
                        "content/optionsSchema.js",
                        "content/api.js",
                        "content/dom.js",
                        "content/jumpTime.js",
                        "content/bpm.js",
                        "content/historyLinks.js",
                        "content/trackHistory.js",
                        "content/bmcButtons.js",
                        "content/fanTracks.js",
                        "content/init.js"
                ],
                "run_at": "document_end"
        }, {
                "matches": ["*://*.buymusic.club/*"],
                "js": ["optionsSchema.js", "bmc.js"],
                "run_at": "document_end"
        }],
        "host_permissions": [
                "https://www.buymusic.club/*",
                "https://*.bandcamp.com/*"
        ],
        "background": {
                "service_worker": "background/index.js",
                "type": "module"
        },
        "icons": {
                "16": "icons/icon16.png",
                "32": "icons/icon32.png",
                "64": "icons/icon64.png",
                "128": "icons/icon128.png"
        },
        "action": {
                "default_icon": {
                        "16": "icons/icon16.png",
                        "32": "icons/icon32.png"
                },
                "default_title": "POWERDIGGER for Bandcamp",
                "default_popup": "options.html"
        },
        "description": "Supercharge your Bandcamp discovery: browser & play history highlights, tracks-in-common badges, Buy Music Club integration, track-skip, and more.",
        "author": "Ayra"
}
