{
        "manifest_version": 3,
        "name": "POWERDIGGER for Bandcamp",
        "version": "1.0.5",
        "permissions": [
                "storage",
                "unlimitedStorage"
        ],
        "optional_permissions": [
                "history",
                "downloads",
                "management"
        ],
        "content_scripts": [{
                "matches": ["*://*.bandcamp.com/*"],
                "js": ["BCcontentScript.js"],
                "run_at": "document_end"
        }, {
                "matches": ["*://*.buymusic.club/*"],
                "js": ["BMCcontentScript.js"],
                "run_at": "document_end"
        }],
        "host_permissions": ["https://www.buymusic.club/*"],
        "background": {
                "service_worker": "background.js"
        },
        "icons": {
                "16": "icons/icon16.png",
                "32": "icons/icon32.png",
                "64": "icons/icon64.png",
                "128": "icons/icon128.png"
        },
        "action": {
                "default_icon": {
                        "16": "icons/icon16.png",
                        "32": "icons/icon32.png"
                },
                "default_title": "POWERDIGGER for Bandcamp",
                "default_popup": "options.html"
        },
        "web_accessible_resources": [{
                "resources": ["library.html"],
                "matches": ["<all_urls>"]
        }],
        "description": "Supercharge your Bandcamp discovery: browser & play history highlights, tracks-in-common badges, Buy Music Club integration, track-skip, and more.",
        "author": "Ayra"
}
